<view class="wrap {{theme === 'dark' ? 'theme-dark' : ''}}">
  <view class="hero">
    <text class="logo">📚</text>
    <text class="title">郑好有你</text>
    <text class="sub">{{tab === 'school' ? '登录你的学号，课表和待办就是你的' : '不登学校账号，记事本和专注也能用'}}</text>
  </view>

  <!-- 身份切换 -->
  <view class="tabs">
    <view class="tab {{tab === 'school' ? 'on' : ''}}" data-tab="school" bindtap="switchTab">本校学生</view>
    <view class="tab {{tab === 'other' ? 'on' : ''}}" data-tab="other" bindtap="switchTab">其他人员</view>
  </view>

  <!-- ===== 本校学生 ===== -->
  <block wx:if="{{tab === 'school'}}">
    <view class="card">
      <view class="field">
        <text class="label">学号</text>
        <input class="input" value="{{username}}" data-field="username" bindinput="onInput" placeholder="你的学号" placeholder-class="ph" />
      </view>

      <view class="field">
        <text class="label">统一身份认证密码</text>
        <input class="input" password value="{{password}}" data-field="password" bindinput="onInput" placeholder="和登学校 App 那个密码一样" placeholder-class="ph" />
      </view>

      <view class="field" wx:if="{{mfaShow}}">
        <text class="label">短信验证码{{phone ? '（' + phone + '）' : ''}}</text>
        <input class="input" type="number" value="{{mfaCode}}" bindinput="onMfaCode" placeholder="填手机上收到的验证码" placeholder-class="ph" />
        <view class="mfa-actions">
          <button class="btn ghost" bindtap="resend" disabled="{{busy}}">重发验证码</button>
          <button class="btn primary" bindtap="verify" disabled="{{busy}}">验证并进入</button>
        </view>
      </view>

      <button class="btn primary big" wx:if="{{!mfaShow}}" bindtap="doLogin" disabled="{{busy}}">
        {{busy ? '处理中…' : '登录并导入课表'}}
      </button>

      <text class="state {{done ? 'ok' : ''}}" wx:if="{{state}}">{{state}}</text>
      <view class="result" wx:if="{{result}}">
        <text class="result-body">{{result}}</text>
      </view>
    </view>

    <view class="sync-all">
      <button class="btn ghost big" bindtap="syncAll" disabled="{{syncBusy}}">
        {{syncBusy ? '正在同步…' : '⟳ 同步全部课程和任务'}}
      </button>
      <text class="sync-state" wx:if="{{syncState}}">{{syncState}}</text>
      <text class="sync-hint">自动同步：云端每小时拉一次所有平台的最新任务（每晚 21 点发订阅提醒）</text>
    </view>

    <text class="skip" bindtap="skip">先跳过，稍后在「登录设置」里绑定 ›</text>
    <text class="note">每个微信号是独立的身份，任务数据互不相通；登录只用于拉你自己的课表和任务。</text>
  </block>

  <block wx:else>
    <!-- ===== 其他人员（访客） =====
         注释必须放在 block 里面：wx:else 要紧跟上一个同级节点，
         中间夹注释会让整条 wx:if / wx:else 链静默失效，访客分支就永远不渲染 -->
    <view class="card">
      <view class="mode-row">
        <text class="mode-title">{{otherMode === 'register' ? '注册一个访客账号' : '登录访客账号'}}</text>
        <text class="mode-link" bindtap="switchOtherMode">{{otherMode === 'register' ? '已有账号 ›' : '去注册 ›'}}</text>
      </view>

      <view class="field">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          value="{{oPhone}}"
          data-field="oPhone"
          bindinput="onOtherInput"
          placeholder="11 位手机号"
          placeholder-class="ph"
        />
      </view>

      <view class="field">
        <text class="label">密码</text>
        <input
          class="input"
          password
          value="{{oPwd}}"
          data-field="oPwd"
          bindinput="onOtherInput"
          placeholder="{{otherMode === 'register' ? '自己设一个，6 位以上' : '注册时设的密码'}}"
          placeholder-class="ph"
        />
      </view>

      <view class="field" wx:if="{{otherMode === 'register'}}">
        <text class="label">再输一次密码</text>
        <input class="input" password value="{{oPwd2}}" data-field="oPwd2" bindinput="onOtherInput" placeholder="两次要一样" placeholder-class="ph" />
      </view>

      <view class="field" wx:if="{{otherMode === 'register'}}">
        <text class="label">昵称（可不填）</text>
        <input class="input" value="{{oNick}}" data-field="oNick" bindinput="onOtherInput" maxlength="12" placeholder="别人怎么称呼你" placeholder-class="ph" />
      </view>

      <button class="btn primary big" bindtap="doOther" disabled="{{otherBusy}}">
        {{otherBusy ? '处理中…' : (otherMode === 'register' ? '注册并进入' : '登录')}}
      </button>

      <text class="state" wx:if="{{otherState}}">{{otherState}}</text>
    </view>

    <view class="guest-tip">
      <text class="guest-tip-title">访客账号能做什么</text>
      <text class="guest-tip-body">记事本、番茄钟、手动加课表、手动建待办都能用。课表从教务导入、学习通 / 希冀 / U校园 这些平台绑定和同步不会开放 —— 那些要学校账号。</text>
      <text class="guest-tip-body">没有短信验证码，密码设好请自己记住（忘了只能换个手机号重新注册）。</text>
    </view>
  </block>
</view>
