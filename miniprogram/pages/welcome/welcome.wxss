page {
  background: var(--bg);
}

.wrap {
  padding: 36rpx 40rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 30rpx;
}

.logo {
  font-size: 84rpx;
  line-height: 1;
}

.title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.4;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 40rpx;
  box-shadow: var(--shadow);
}

.field {
  margin-bottom: 30rpx;
  width: 100%;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

/* 微信 input 组件有默认高度/内边距，不显式钉死就会和 label 错位 */
.input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 24rpx;
  background: var(--card-2);
  border-radius: 14rpx;
  font-size: 30rpx;
  color: var(--text);
  line-height: 92rpx;
  min-height: 92rpx;
}

.ph {
  color: var(--text-3);
}

.mfa-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

/* 微信 button 默认自带宽度和边距，全部重置 */
.btn {
  margin: 0;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn.ghost {
  background: var(--ghost-bg);
  color: var(--ghost-fg);
  flex: 1;
}

.btn.primary {
  background: #5a6cf3;
  color: #fff;
  flex: 1.4;
}

.btn.big {
  width: 100%;
  margin-top: 8rpx;
}

.btn[disabled] {
  opacity: 0.6;
}

.state {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--danger);
  white-space: pre-wrap;
  line-height: 1.5;
}

.state.ok {
  color: var(--ok);
}

.result {
  margin-top: 14rpx;
  background: var(--card-2);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
}

.result-body {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: pre-wrap;
  line-height: 1.6;
}

.sync-all {
  margin-top: 40rpx;
}

.sync-all .btn.ghost.big {
  background: var(--card);
  color: var(--ghost-fg);
  border: 2rpx solid var(--line);
}

.sync-state {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
  white-space: pre-wrap;
  line-height: 1.6;
}

.sync-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  text-align: center;
}

.skip {
  display: block;
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.note {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 0 30rpx;
  line-height: 1.6;
}

/* ================= 身份切换 ================= */
.tabs {
  display: flex;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: var(--card-2);
}

.tab {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

.tab.on {
  background: var(--card);
  color: var(--brand);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(90, 108, 243, 0.14);
}

/* ================= 访客 ================= */
.mode-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.mode-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.mode-link {
  font-size: 25rpx;
  color: var(--brand);
}

.guest-tip {
  margin-top: 32rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: var(--card-2);
}

.guest-tip-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.guest-tip-body {
  display: block;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin-top: 6rpx;
}
