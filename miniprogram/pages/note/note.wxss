.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ================= 顶部 ================= */
.head {
  background: var(--bg);
}

.nav {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-ico {
  font-size: 52rpx;
  line-height: 1;
  color: var(--text);
  margin-top: -6rpx;
}

.nav-state {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 10rpx;
}

.nav-done {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 8rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--brand);
  margin-right: 190rpx; /* 避开右上角胶囊 */
}

/* ================= 纸面 ================= */
.paper {
  flex: 1;
  margin: 8rpx 24rpx 0;
  padding: 32rpx 30rpx 20rpx;
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  /* 底部工具栏 + 安全区 */
  margin-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.paper-plain { background: var(--card); }
.paper-yellow { background: #FFF7D6; }
.paper-pink { background: #FDEAF0; }
.paper-blue { background: #E8F1FE; }
.paper-green { background: #E4F7EE; }
.paper-purple { background: #F1ECFE; }

.theme-dark .paper-plain { background: var(--card); }
.theme-dark .paper-yellow { background: #3B3524; }
.theme-dark .paper-pink { background: #3B2831; }
.theme-dark .paper-blue { background: #22303F; }
.theme-dark .paper-green { background: #1E3329; }
.theme-dark .paper-purple { background: #2C2740; }

.ipt-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
  letter-spacing: 0.4rpx;
  min-height: 60rpx;
}

.ph-title {
  color: var(--text-3);
  font-weight: 700;
}

.paper-line {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
  opacity: 0.8;
}

.ipt-body {
  flex: 1;
  width: 100%;
  min-height: 520rpx;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.72;
}

.ph-body {
  color: var(--text-3);
}

/* ================= 底部工具栏 ================= */
.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
  z-index: 30;
}

.tool {
  width: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
}

.tool-ico {
  font-size: 32rpx;
  line-height: 1.3;
}

.tool-txt {
  font-size: 19rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.tool-txt.is-danger {
  color: var(--danger);
}

.tool-chars {
  flex: 1;
  text-align: right;
  font-size: 21rpx;
  color: var(--text-3);
  padding-right: 8rpx;
}

/* ================= 调色板 ================= */
.palette {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(20, 24, 60, 0.16);
  z-index: 31;
}

.pal {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pal.is-on {
  border-color: var(--brand);
  border-width: 3rpx;
}

.pal-check {
  font-size: 26rpx;
  color: #4C45D6;
  font-weight: 700;
}

.sw-plain { background: #FFFFFF; }
.sw-yellow { background: #FFE9A8; }
.sw-pink { background: #FBCFE0; }
.sw-blue { background: #C7DDFB; }
.sw-green { background: #BFEBD7; }
.sw-purple { background: #DCD3FB; }

.theme-dark .sw-plain { background: #262938; }

.hov {
  opacity: 0.6;
}
